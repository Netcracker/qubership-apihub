# Copy this file to .env.after and fill in the values locally.
# See SKILL.md section 1 for the inputs required by each analysis mode.

# One APIHub deployment for both migration IDs.
APIHUB_URL=
# Existing key for migration diagnostics and build source/result archives.
APIHUB_API_KEY=
# Separate viewer key for other documented JSON GETs; optional until needed.
APIHUB_READ_ONLY_API_KEY=
# Required for full comparison or persistent/new/resolved error analysis.
# Leave empty for error analysis of a single migration.
PREV_MIG_ID=
MIG_ID=
# Required for full migration comparison only.
BACKEND_BRANCH_AFTER=
BUILD_TASK_CONSUMER_BRANCH_AFTER=

# Required only for database diagnostics against the after snapshot.
# Use an existing SELECT-only account.
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
DB_SCHEMA=
PGSSLMODE=
