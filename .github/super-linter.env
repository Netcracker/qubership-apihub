# File will be loaded as environment variables
# It must contain strings like:
# name=value

GITLEAKS_LOG_LEVEL=warn
VALIDATE_JAVASCRIPT_PRETTIER=false
VALIDATE_JSCPD=false
VALIDATE_JSON_PRETTIER=false
VALIDATE_KUBERNETES_KUBECONFORM=false
VALIDATE_MARKDOWN_PRETTIER=false
VALIDATE_YAML_PRETTIER=false

# TODO: fix python files and enable the check again
VALIDATE_PYTHON_BLACK=false
VALIDATE_PYTHON_FLAKE8=false
VALIDATE_PYTHON_ISORT=false
VALIDATE_PYTHON_MYPY=false
VALIDATE_PYTHON_PYLINT=false
# Ruff came with super-linter v9.
VALIDATE_PYTHON_RUFF=false
VALIDATE_PYTHON_RUFF_FORMAT=false

# APIHUB CUSTOM

# APM agent content (deployed harness + local package sources + compiled agent docs)
# Super-linter v7.3.0 honors only this global FILTER_REGEX_EXCLUDE for most linters (a <LINTER>_FILTER_REGEX_EXCLUDE
# variable had no effect for CSS, HTML, SQLFLUFF, YAML in PR 876), so linter-specific excludes are appended here
# and scoped by file extension. Reasons: monorepo_migration/reports/8-report.md ("PR 876 round 1").
# CSS: VALIDATE_CSS is false (stylelint-config-standard flags notation in product CSS).
# The portal-backend export template styles stay in this exclude so the file-wide checks skip them
# (BEM class names such as header__logo; renaming changes output).
# HTML: legacy export pages (BEM class names, printf placeholders such as %s in attributes, no alt).
# Copies live under portal-backend/static/templates, api-processor/test/templates, and
# build-task-consumer/src/templates.
# Gitleaks: a mock API key in the portal dev server (packages.ts) and a sample version key whose
# field is named "key" (version-content-samples.ts). Neither value is a credential.
# JSON: nested .eslintrc.json files of the frontend modules and ui-tests need plugins that the action image lacks
# (eslint-plugin-storybook), so the run aborts. Frontend, sites, and ui-tests JSON is not linted by super-linter.
# Sites: sites/*/dist/ (build output) and sites/landing/public/images/architecture/ (copied from docs/images) are generated.
# SQL: applied migrations are frozen history (portal-backend 1-44, api-linter-service 1-4, agents-backend 1-2).
# Migration 45 and later are linted.
# YAML: generated pnpm-lock.yaml (13908 findings), Helm templates (Go templates are not YAML before rendering),
# and test data or samples.
# Markdown: LLM prompt resources embedded in the product under static/templates/resources/mcp.
# Markdown fixtures: api-processor/test/**/*.md, ui-tests/resources/**/*.md,
# api-doc-viewer/packages/samples/**/*.md.
FILTER_REGEX_EXCLUDE=(/|^)\.(cursor|claude|agents)(/|$)|(/|^)\.github/(instructions|skills|prompts)(/|$)|(/|^)agent-packages(/|$)|(/|^)(AGENTS|GEMINI|CLAUDE)\.md$|(/|^)backend/test-service/static(/|$)|(/|^)frontend/api-processor/test/projects/(broken|reference-bundling/unparsable-reference)(/|$)|(/|^)frontend/api-processor/test/projects/bugs/hidden-files-without-extension/README\.md$|(/|^)frontend/api-processor/test/projects/tolerant-publication/unparsable-async\.yaml$|(/|^)apm\.lock\.yaml$|(/|^)backend/portal-backend/static/templates/.*\.css$|(/|^)backend/portal-backend/static/templates/.*\.html$|(/|^)frontend/api-processor/test/templates/.*\.html$|(/|^)frontend/build-task-consumer/src/templates/.*\.html$|(/|^)frontend/ui/packages/portal/server/routers/packages/packages\.ts$|(/|^)frontend/ui/packages/shared/src/stories/samples/version-content-samples\.ts$|(/|^)(frontend|sites|tests/ui-tests)/.*\.(json|jsonc|json5)$|(/|^)backend/portal-backend/resources/migrations/([1-9]|[1-3][0-9]|4[0-4])_.*\.sql$|(/|^)backend/(api-linter-service|agents-backend)/resources/migrations/[1-4]_.*\.sql$|(/|^)sites/[^/]+/dist(/|$)|(/|^)sites/landing/public/images/architecture(/|$)|(/|^)pnpm-lock\.yaml$|(/|^)(deploy/helm-templates|backend/[^/]+/(helm|helm-template|helm-templates))/.*/templates/.*\.ya?ml$|(/|^)frontend/(compatibility-suites/bin|rest-playground/src/web-components/samples)/.*\.ya?ml$|(/|^)frontend/[^/]+/packages/samples/.*\.ya?ml$|(/|^)frontend/ui/packages/[^/]+/server/(mocks|resources)/.*\.ya?ml$|(/|^)backend/portal-backend/tests/api/fixtures/.*\.ya?ml$|(/|^)tests/ui-tests/resources/.*\.ya?ml$|(/|^)backend/portal-backend/static/templates/resources/mcp/.*\.md$|(/|^)frontend/api-processor/test/.*\.md$|(/|^)tests/ui-tests/resources/.*\.md$|(/|^)frontend/api-doc-viewer/packages/samples/.*\.md$
MARKDOWN_FILTER_REGEX_EXCLUDE=(/|^)\.(cursor|claude|agents)(/|$)|(/|^)\.github/(instructions|skills|prompts)(/|$)|(/|^)agent-packages(/|$)|(/|^)(AGENTS|GEMINI|CLAUDE)\.md$|(/|^)backend/test-service/static(/|$)|(/|^)frontend/api-processor/test/projects/(broken|reference-bundling/unparsable-reference)(/|$)|(/|^)frontend/api-processor/test/projects/bugs/hidden-files-without-extension/README\.md$|(/|^)frontend/api-processor/test/projects/tolerant-publication/unparsable-async\.yaml$|(/|^)apm\.lock\.yaml$
NATURAL_LANGUAGE_FILTER_REGEX_EXCLUDE=(/|^)\.(cursor|claude|agents)(/|$)|(/|^)\.github/(instructions|skills|prompts)(/|$)|(/|^)agent-packages(/|$)|(/|^)(AGENTS|GEMINI|CLAUDE)\.md$|(/|^)backend/test-service/static(/|$)|(/|^)frontend/api-processor/test/projects/(broken|reference-bundling/unparsable-reference)(/|$)|(/|^)frontend/api-processor/test/projects/bugs/hidden-files-without-extension/README\.md$|(/|^)frontend/api-processor/test/projects/tolerant-publication/unparsable-async\.yaml$|(/|^)apm\.lock\.yaml$|(/|^)backend/portal-backend/static/templates/resources/mcp(/|$)|(/|^)__fixtures__(/|$)

# Excludes for editorconfig-checker; file MUST be under .github/linters/ (not repo root)
EDITORCONFIG_FILE_NAME=.editorconfig-checker.json

# Go linter has a bug and doesn't work fine
VALIDATE_GO=false
VALIDATE_GO_MODULES=false

# Another tool used in APIHUB for typescript linting.
# stylelint-config-standard flags notation in product CSS (the GraphQL debug page and the legacy
# export styles). The frontend does not use this check.
VALIDATE_CSS=false
VALIDATE_CSS_PRETTIER=false
VALIDATE_HTML_PRETTIER=false
VALIDATE_JAVASCRIPT_ES=false
VALIDATE_TYPESCRIPT_ES=false
VALIDATE_TYPESCRIPT_PRETTIER=false

# Disable more strange checks
VALIDATE_BASH_EXEC=false
VALIDATE_SHELL_SHFMT=false

# The markdownlint config of this repository is .markdownlint.json; the super-linter default name is
# .markdown-lint.yml, so without this line the file is ignored (MD013 400, MD025 off, MD024 siblings_only)
MARKDOWN_CONFIG_FILE=.markdownlint.json

# Per-linter settings. Decisions and reasons: monorepo_migration/reports/8-report.md
# CHECKOV test data is skipped by skip-path in .github/linters/.checkov.yaml (checkov scans directories).

VALIDATE_TSX=false

# Linters added after super-linter v7.3.0 (off in the netcracker/.github common config too).
# Biome: the frontend modules use ESLint and dprint; Biome reports thousands of formatting findings.
VALIDATE_BIOME_FORMAT=false
VALIDATE_BIOME_LINT=false
# zizmor: GitHub Actions security audit; actionlint (GITHUB_ACTIONS) stays on.
VALIDATE_GITHUB_ACTIONS_ZIZMOR=false
# Trivy: security-scan-apihub.yml scans the source already; here it resolves Maven POMs over the network
# and fails on rate limits of Maven Central (HTTP 429).
VALIDATE_TRIVY=false

# shellcheck: fail on errors only (warnings are style findings in the deploy quickstart scripts).
BASH_SEVERITY=error
