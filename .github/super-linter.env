# File will be loaded as environment variables
# It must contain strings like:
# name=value

GITLEAKS_LOG_LEVEL=warn
VALIDATE_JAVASCRIPT_PRETTIER=false
VALIDATE_JAVASCRIPT_STANDARD=false
VALIDATE_JSCPD=false
VALIDATE_JSON_PRETTIER=false
VALIDATE_KUBERNETES_KUBECONFORM=false
VALIDATE_MARKDOWN_PRETTIER=false
VALIDATE_YAML_PRETTIER=false

# TODO: fix python files and enable the check again
VALIDATE_PYTHON_BLACK=false
VALIDATE_PYTHON_FLAKE8=false
VALIDATE_PYTHON_ISORT=false
VALIDATE_PYTHON_MYPY=false
VALIDATE_PYTHON_PYINK=false
VALIDATE_PYTHON_PYLINT=false

# APIHUB CUSTOM

# APM agent content (deployed harness + local package sources + compiled agent docs)
# Super-linter v7.3.0 honors only this global FILTER_REGEX_EXCLUDE for most linters (a <LINTER>_FILTER_REGEX_EXCLUDE
# variable had no effect for CSS, HTML, SQLFLUFF, YAML in PR 876), so linter-specific excludes are appended here
# and scoped by file extension. Reasons: monorepo_migration/reports/8-report.md ("PR 876 round 1").
# CSS: legacy portal-backend export template styles (BEM class names such as header__logo; renaming changes output).
FILTER_REGEX_EXCLUDE=(/|^)\.(cursor|claude|agents)(/|$)|(/|^)\.github/(instructions|skills|prompts)(/|$)|(/|^)agent-packages(/|$)|(/|^)(AGENTS|GEMINI|CLAUDE)\.md$|(/|^)docs/pages/erd(/|$)|(/|^)backend/test-service/static(/|$)|(/|^)frontend/api-processor/test/projects/(broken|reference-bundling/unparsable-reference)(/|$)|(/|^)frontend/api-processor/test/projects/bugs/hidden-files-without-extension/README\.md$|(/|^)frontend/api-processor/test/projects/tolerant-publication/unparsable-async\.yaml$|(/|^)apm\.lock\.yaml$|(/|^)backend/portal-backend/static/templates/.*\.css$
MARKDOWN_FILTER_REGEX_EXCLUDE=(/|^)\.(cursor|claude|agents)(/|$)|(/|^)\.github/(instructions|skills|prompts)(/|$)|(/|^)agent-packages(/|$)|(/|^)(AGENTS|GEMINI|CLAUDE)\.md$|(/|^)docs/pages/erd(/|$)|(/|^)backend/test-service/static(/|$)|(/|^)frontend/api-processor/test/projects/(broken|reference-bundling/unparsable-reference)(/|$)|(/|^)frontend/api-processor/test/projects/bugs/hidden-files-without-extension/README\.md$|(/|^)frontend/api-processor/test/projects/tolerant-publication/unparsable-async\.yaml$|(/|^)apm\.lock\.yaml$
NATURAL_LANGUAGE_FILTER_REGEX_EXCLUDE=(/|^)\.(cursor|claude|agents)(/|$)|(/|^)\.github/(instructions|skills|prompts)(/|$)|(/|^)agent-packages(/|$)|(/|^)(AGENTS|GEMINI|CLAUDE)\.md$|(/|^)docs/pages/erd(/|$)|(/|^)backend/test-service/static(/|$)|(/|^)frontend/api-processor/test/projects/(broken|reference-bundling/unparsable-reference)(/|$)|(/|^)frontend/api-processor/test/projects/bugs/hidden-files-without-extension/README\.md$|(/|^)frontend/api-processor/test/projects/tolerant-publication/unparsable-async\.yaml$|(/|^)apm\.lock\.yaml$|(/|^)backend/portal-backend/static/templates/resources/mcp(/|$)|(/|^)__fixtures__(/|$)

# Excludes for editorconfig-checker; file MUST be under .github/linters/ (not repo root)
EDITORCONFIG_FILE_NAME=.editorconfig-checker.json

# Go linter has a bug and doesn't work fine
VALIDATE_GO=false
VALIDATE_GO_MODULES=false

# Another tool used in APIHUB for typescript linting
VALIDATE_CSS_PRETTIER=false
VALIDATE_HTML_PRETTIER=false
VALIDATE_JAVASCRIPT_ES=false
VALIDATE_TYPESCRIPT_ES=false
VALIDATE_TYPESCRIPT_PRETTIER=false

# Disable more strange checks
VALIDATE_BASH_EXEC=false
VALIDATE_SHELL_SHFMT=false

# The markdownlint config of this repository is .markdownlint.json; the super-linter default name is
# .markdown-lint.yml, so without this line the file is ignored (MD013 400, MD025 off, MD024 siblings_only)
MARKDOWN_CONFIG_FILE=.markdownlint.json

# Per-linter excludes. Decisions and reasons: monorepo_migration/reports/8-report.md
# Test data and samples: not product code, the findings are the point of the data.
CHECKOV_FILTER_REGEX_EXCLUDE=(/|^)frontend/(compatibility-suites/bin|api-processor/test|api-diff/test|api-unifier/test)(/|$)|(/|^)frontend/[^/]+/packages/samples(/|$)|(/|^)frontend/ui/packages/[^/]+/server/(mocks|resources)(/|$)|(/|^)frontend/rest-playground/src/web-components/samples(/|$)|(/|^)backend/portal-backend/tests/api/fixtures(/|$)|(/|^)tests/(ui-tests/resources|postman-collections/working-directory)(/|$)

# Nested .eslintrc.json files of the frontend modules need their plugins installed; TypeScript lint stays with Nx.
JSON_FILTER_REGEX_EXCLUDE=(/|^)(frontend|tests/ui-tests)(/|$)

JSONC_FILTER_REGEX_EXCLUDE=(/|^)(frontend|tests/ui-tests)(/|$)

VALIDATE_TSX=false

VALIDATE_TYPESCRIPT_STANDARD=false

# Generated files, Helm templates (Go templates are not YAML before rendering), and test data or samples.
YAML_FILTER_REGEX_EXCLUDE=(/|^)pnpm-lock\.yaml$|(/|^)(deploy/helm-templates|backend/[^/]+/(helm|helm-template|helm-templates))/.*/templates/|(/|^)frontend/(compatibility-suites/bin|rest-playground/src/web-components/samples)(/|$)|(/|^)frontend/[^/]+/packages/samples(/|$)|(/|^)frontend/ui/packages/[^/]+/server/(mocks|resources)(/|$)|(/|^)backend/portal-backend/tests/api/fixtures(/|$)|(/|^)tests/ui-tests/resources(/|$)

# Legacy portal-backend export templates (BEM class names, printf placeholders).
HTML_FILTER_REGEX_EXCLUDE=(/|^)backend/portal-backend/static/templates(/|$)

# Applied migrations are frozen history: portal-backend 1-44, api-linter-service 1-4, agents-backend 1-2.
# Migration 45 and later are linted.
SQLFLUFF_FILTER_REGEX_EXCLUDE=(/|^)backend/portal-backend/resources/migrations/([1-9]|[1-3][0-9]|4[0-4])_|(/|^)backend/(api-linter-service|agents-backend)/resources/migrations/[1-4]_

# shellcheck: fail on errors only (warnings are style findings in the deploy quickstart scripts).
BASH_SEVERITY=error
