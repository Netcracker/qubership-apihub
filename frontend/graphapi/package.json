{
  "name": "@netcracker/qubership-apihub-graphapi",
  "version": "1.0.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Netcracker/qubership-apihub.git",
    "directory": "frontend/graphapi"
  },
  "bugs": {
    "url": "https://github.com/Netcracker/qubership-apihub/issues"
  },
  "homepage": "https://github.com/Netcracker/qubership-apihub/tree/main/frontend/graphapi#readme",
  "description": "The GraphAPI Specification Repository",
  "module": "./dist/index.es.js",
  "main": "./dist/index.cjs.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "lint:check": "eslint -c .eslintrc.json . --ext .js,.cjs,.ts,.json --ignore-path .gitignore --max-warnings 0 --report-unused-disable-directives",
    "storybook": "storybook dev -p 6006",
    "build:showcase": "storybook build -o dist-showcase",
    "lint:fix": "pnpm run lint:check -- --fix",
    "prebuild": "rimraf ./dist",
    "build": "vite build",
    "test": "jest --maxWorkers 3 --verbose",
    "test:coverage": "jest --verbose --coverage",
    "build:web": "webpack",
    "feature-start": "feature-start --featureName",
    "feature-finish": "feature-finish",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "jsonschema",
    "introspection",
    "graphql",
    "schema",
    "api"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/addon-onboarding": "10.6.3",
    "@storybook/react-vite": "catalog:",
    "@types/jest": "catalog:",
    "@types/json-schema": "^7.0.11",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "6.0.0",
    "@typescript-eslint/parser": "6.0.0",
    "eslint": "8.48.0",
    "eslint-plugin-storybook": "catalog:",
    "fast-json-patch": "^3.1.1",
    "graphql": "16.12.0",
    "jest": "catalog:",
    "jest-util": "catalog:",
    "json-schema": "^0.4.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "3.0.2",
    "storybook": "catalog:",
    "ts-jest": "catalog:",
    "ts-loader": "^8.0.8",
    "ts-node": "^10.7.0",
    "tslint": "^6.1.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "webpack": "5.97.1",
    "yaml": "2.9.0"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/test/.*|(\\.)(test|spec))\\.(ts?|tsx?|js?|jsx?)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/test/helpers/",
      "<rootDir>/test/resources/"
    ],
    "collectCoverage": true
  },
  "eslintConfig": {
    "extends": ".eslintrc.json"
  },
  "nx": {
    "name": "graphapi"
  }
}
