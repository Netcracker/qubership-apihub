{
  "name": "@netcracker/qubership-apihub-api-unifier",
  "version": "2.9.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Netcracker/qubership-apihub.git",
    "directory": "frontend/api-unifier"
  },
  "bugs": {
    "url": "https://github.com/Netcracker/qubership-apihub/issues"
  },
  "homepage": "https://github.com/Netcracker/qubership-apihub/tree/main/frontend/api-unifier#readme",
  "description": "Tools for JsonSchema/Openapi/GraphQL spec for unified processing",
  "module": "./dist/index.es.js",
  "main": "./dist/index.cjs.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "lint:check": "eslint -c .eslintrc.json . --ext .js,.cjs,.ts,.json --ignore-path .gitignore --max-warnings 0 --report-unused-disable-directives",
    "lint:fix": "pnpm run lint:check -- --fix",
    "prebuild": "rimraf ./dist",
    "build": "vite build",
    "performance:run-inspect": "vite build --sourcemap=inline -c=vite.performance.config.ts && node --inspect dist/index.es.mjs",
    "test": "jest --verbose --maxWorkers 3",
    "test:coverage": "jest --verbose --coverage"
  },
  "keywords": [
    "json",
    "schema",
    "json-schema",
    "jsonschema",
    "openapi",
    "swagger",
    "allof",
    "merge",
    "resolve",
    "simplify"
  ],
  "dependencies": {
    "@netcracker/qubership-apihub-ddlapi": "workspace:^",
    "@netcracker/qubership-apihub-graphapi": "workspace:^",
    "@netcracker/qubership-apihub-json-crawl": "workspace:^",
    "fast-equals": "^6.0.2",
    "flatted": "^3.2.9",
    "object-hash": "3.0.0"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.0",
    "@jest/globals": "30.4.1",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/object-hash": "3.0.6",
    "@typescript-eslint/eslint-plugin": "6.0.0",
    "@typescript-eslint/parser": "6.0.0",
    "eslint": "8.48.0",
    "graphql": "16.12.0",
    "jest": "30.4.2",
    "jest-extended": "4.0.2",
    "jest-util": "^30.4.1",
    "json-schema-merge-allof": "0.8.1",
    "openapi-types": "12.1.3",
    "rimraf": "5.0.5",
    "ts-jest": "29.4.12",
    "ts-loader": "9.4.3",
    "ts-node": "10.7.0",
    "tslint": "6.1.2",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-target": "0.1.1",
    "yaml": "2.9.0"
  },
  "nx": {
    "name": "api-unifier"
  }
}
