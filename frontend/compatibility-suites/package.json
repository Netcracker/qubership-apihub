{
  "name": "@netcracker/qubership-apihub-compatibility-suites",
  "version": "2.6.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Netcracker/qubership-apihub.git",
    "directory": "frontend/compatibility-suites"
  },
  "bugs": {
    "url": "https://github.com/Netcracker/qubership-apihub/issues"
  },
  "homepage": "https://github.com/Netcracker/qubership-apihub/tree/main/frontend/compatibility-suites#readme",
  "license": "Apache-2.0",
  "type": "module",
  "module": "./dist/index.es.js",
  "main": "./dist/index.cjs.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "src",
    "bin",
    "index.ts"
  ],
  "scripts": {
    "build": "pnpm run generate && vite build",
    "generate": "tsx bin/generate-suite-data.ts",
    "type-check": "pnpm run generate && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tslib": "^2.8.1",
    "tsx": "4.8.1",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4",
    "yaml": "2.9.0"
  },
  "nx": {
    "name": "compatibility-suites"
  }
}
