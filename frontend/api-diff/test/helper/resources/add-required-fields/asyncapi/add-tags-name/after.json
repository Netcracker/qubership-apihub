{
    "asyncapi": "3.0.0",
    "info": {
        "title": "AsyncAPI Example",
        "description": "Example",
        "version": "1.0.0",
        "tags": [
            {
                "name": "infoTag",
                "description": "Public endpoints"
            }
        ]
    },
    "servers": {
        "production": {
            "host": "api.example.com",
            "protocol": "https",
            "description": "Production server",
            "tags": [
                {
                    "name": "serverTag",
                    "description": "Public endpoints"
                }
            ]
        }
    },
    "channels": {
        "userSignup": {
            "address": "/api/v1/users/{userId}/signup",
            "description": "Channel for user signup events",
            "tags": [
                {
                    "name": "publicTag",
                    "description": "Public endpoints"
                }
            ],
            "messages": {
                "signupRequest": {
                    "$ref": "#/components/messages/signupRequest"
                }
            }
        }
    },
    "operations": {
        "handleUserSignup": {
            "action": "receive",
            "summary": "Handle user signup",
            "description": "Process user signup requests",
            "channel": {
                "$ref": "#/channels/userSignup"
            },
            "messages": {
                "signupRequest": {
                    "$ref": "#/channels/userSignup/messages/signupRequest"
                }
            },
            "tags": [
                {
                    "$ref": "#/components/tags/componentTag"
                },
                {
                    "name": "operationTag",
                    "description": "Public endpoints"
                }
            ]
        }
    },
    "components": {
        "messages": {
            "signupRequest": {
                "summary": "User signup request",
                "description": "Request payload for user signup",
                "contentType": "application/json",
                "payload": {
                    "type": "object",
                    "properties": {
                        "userId": {
                            "type": "string"
                        },
                        "email": {
                            "type": "string"
                        },
                        "password": {
                            "type": "string"
                        }
                    }
                },
                "tags": [
                    {
                        "name": "messageTag",
                        "description": "Public endpoints"
                    }
                ]
            }
        },
        "tags": {
            "componentTag": {
                "name": "component",
                "description": "Public endpoints"
            }
        }
    }
}
