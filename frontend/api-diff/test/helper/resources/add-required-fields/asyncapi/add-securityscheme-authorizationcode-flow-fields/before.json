{
    "asyncapi": "3.0.0",
    "info": {
        "title": "AsyncAPI Example",
        "description": "Example",
        "version": "1.0.0"
    },
    "channels": {
        "userSignup": {
            "address": "/api/v1/users/{userId}/signup",
            "description": "Channel for user signup events"
        }
    },
    "operations": {
        "handleUserSignup": {
            "action": "receive",
            "summary": "Handle user signup",
            "description": "Process user signup requests",
            "security": [
                {
                    "$ref": "#/components/securitySchemes/oauth2Auth"
                }
            ],
            "channel": {
                "$ref": "#/channels/userSignup"
            }
        }
    },
    "components": {
        "securitySchemes": {
            "oauth2Auth": {
                "type": "oauth2",
                "flows": {
                    "authorizationCode": {
                        "refreshUrl": "https://auth.example.com/oauth/refresh"
                    }
                }
            }
        }
    }
}
