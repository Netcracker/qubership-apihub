{
    "asyncapi": "3.0.0",
    "info": {
        "title": "AsyncAPI Example",
        "description": "Example",
        "version": "1.0.0"
    },
    "servers": {
        "production": {
            "host": "api.example.com",
            "protocol": "https",
            "description": "Production server"
        }
    },
    "channels": {
        "userSignup": {
            "$ref": "#/components/channels/userSignup"
        }
    },
    "operations": {
        "handleUserSignup": {
            "action": "receive",
            "summary": "Handle user signup",
            "description": "Process user signup requests",
            "channel": {
                "$ref": "#/channels/userSignup"
            }
        }
    },
    "components": {
        "channels": {
            "userSignup": {
                "address": "/api/v1/users/{userId}/signup",
                "description": "Channel for user signup events",
                "servers": [
                    {
                        "$ref": "#/servers/production"
                    },
                    {
                        "$ref": "#/components/servers/development"
                    }
                ]
            }
        },
        "servers": {
            "development": {
                "host": "localhost:8080",
                "protocol": "http",
                "description": "Development server"
            }
        }
    }
}
