{
  "name": "@netcracker/qubership-apihub-ui-portal",
  "version": "3.10.2",
  "license": "Apache-2.0",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "npm run build:tsc && npm run build:vite",
    "build:tsc": "tsc && tsc --project server/tsconfig.json",
    "build:vite": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:analyze": "npm run build:tsc && npm run build:vite -- --mode analyze",
    "dev:backend": "nodemon --watch server --ext ts,json server/index.ts",
    "dev:frontend": "vite --host --force",
    "dev:proxy": "vite --host --mode=proxy --force",
    "dev:proxy:msw": "cross-env VITE_ENABLE_MSW=true vite --host --mode=proxy --force",
    "preview": "npm run build && vite preview --host --mode=proxy",
    "test:server": "jest -c server/jest.config.mjs",
    "lint:check": "eslint . --ext .ts,.tsx,.json --ignore-path ../../.gitignore --max-warnings 0 --report-unused-disable-directives",
    "lint:fix": "npm run lint:check -- --fix"
  },
  "dependencies": {
    "@asyncapi/parser": "3.6.0",
    "@lit-labs/react": "1.1.1",
    "@mui/icons-material": "5.11.9",
    "@mui/lab": "5.0.0-alpha.120",
    "@mui/material": "5.11.10",
    "@mui/system": "5.18.0",
    "@mui/types": "7.4.5",
    "@remix-run/router": "1.11.0",
    "@stoplight/json": "3.21.7",
    "@stoplight/json-ref-resolver": "3.1.4",
    "@stoplight/spectral-core": "1.16.1",
    "@stoplight/types": "13.20.0",
    "@tanstack/query-core": "^4.43.0",
    "@tanstack/react-query": "^4.43.0",
    "@tanstack/react-query-devtools": "^4.43.0",
    "@tanstack/react-table": "8.8.0",
    "@tanstack/table-core": "8.8.0",
    "@types/lodash-es": "^4.17.12",
    "comlink": "4.4.1",
    "github-markdown-css": "5.1.0",
    "highlight.js": "11.11.1",
    "js-file-download": "0.4.12",
    "jszip": "3.10.1",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "monaco-editor": "0.52.2",
    "openapi3-ts": "2.0.2",
    "re-resizable": "6.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "7.39.7",
    "react-mark.js": "9.0.7",
    "react-markdown": "^8.0.7",
    "react-multi-date-picker": "4.1.1",
    "react-router": "6.18.0",
    "react-router-dom": "6.18.0",
    "react-use": "^17.6.0",
    "react-virtualized-auto-sizer": "1.0.24",
    "react-window": "^1.8.10",
    "react-window-infinite-loader": "1.0.9",
    "rehype-highlight": "6.0.0",
    "remark-gfm": "3.0.1",
    "ts-event-bus": "4.1.1",
    "unified": "10.1.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@netcracker/qubership-apihub-ui-shared": "*",
    "@rollup/plugin-inject": "5.0.5",
    "@storybook/react-vite": "10.5.10",
    "@types/cors": "2.8.13",
    "@types/express": "4.17.17",
    "@types/express-ws": "3.0.1",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-virtualized-auto-sizer": "1.0.4",
    "@types/react-window": "1.8.8",
    "@types/react-window-infinite-loader": "1.0.9",
    "@types/supertest": "7.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "buffer": "5.7.1",
    "cors": "2.8.5",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "express": "5.2.1",
    "jest": "30.4.2",
    "nodemon": "2.0.20",
    "openapi-types": "^12.1.0",
    "process": "0.11.10",
    "rollup-plugin-copy": "3.4.0",
    "rollup-plugin-visualizer": "5.9.0",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "unplugin-fonts": "^2.0.0",
    "vite": "^8.2.2",
    "vite-plugin-monaco-editor": "1.1.0",
    "vite-tsconfig-paths": "^4.3.2"
  }
