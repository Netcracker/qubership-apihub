{
  "extends": "@stoplight/scripts/tsconfig.json",
  // target all ts files
  "include": [
    "."
  ],
  "compilerOptions": {
    "module": "commonjs",
    "noUnusedLocals": false,
    // @stoplight/scripts/tsconfig.json sets "suppressImplicitAnyIndexErrors": true.
    // TypeScript 5.5 removed that option and TS 6 rejects it outright (TS5102, a
    // removal rather than a deprecation, so "ignoreDeprecations" does not apply).
    // The base config lives in node_modules and cannot be edited, but overriding the
    // value to false is accepted - TS only errors when it is set to true.
    "suppressImplicitAnyIndexErrors": false,
    // The base config also sets "moduleResolution": "node", which TypeScript 7 removed
    // (TS5108). Same situation as the option above: node_modules cannot be edited, so it is
    // overridden here. 'bundler' because sl-scripts bundles this package.
    "moduleResolution": "bundler"
  },
}
