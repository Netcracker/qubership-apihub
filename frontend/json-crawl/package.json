{
  "name": "@netcracker/qubership-apihub-json-crawl",
  "version": "1.2.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Netcracker/qubership-apihub.git",
    "directory": "frontend/json-crawl"
  },
  "bugs": {
    "url": "https://github.com/Netcracker/qubership-apihub/issues"
  },
  "homepage": "https://github.com/Netcracker/qubership-apihub/tree/main/frontend/json-crawl#readme",
  "description": "Async and sync crawler for json object",
  "module": "./dist/index.es.js",
  "main": "./dist/index.cjs.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "vite build",
    "test": "jest --verbose",
    "test:coverage": "jest --verbose --coverage"
  },
  "keywords": [
    "json",
    "crawler",
    "crawl",
    "deepClone",
    "clone",
    "hooks"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "jest-util": "catalog:",
    "rimraf": "^5.0.5",
    "rollup": "^2.79.1",
    "rollup-plugin-filesize": "^9.1.0",
    "rollup-plugin-progress": "^1.1.2",
    "ts-jest": "catalog:",
    "ts-node": "^10.7.0",
    "tslint": "^6.1.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/test/.*(\\.|/)(test|spec))\\.(ts?|tsx?|js?|jsx?)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ],
    "collectCoverage": true
  },
  "nx": {
    "name": "json-crawl"
  }
}
