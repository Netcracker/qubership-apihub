  "//overrides": [
    "@stoplight/mosaic: it declares \"@types/react\": \"^17.0.3\" as a hard dependency -",
    "still true at 1.53.5, the latest - so with these packages on React 18 npm nests React 17",
    "types under it and the program holds two React identities, which is TS2786",
    "\"X cannot be used as a JSX component\" on every mosaic component. $@types/react resolves",
    "to whatever this manifest declares, so the two cannot drift. Remove when mosaic",
    "republishes its declarations against React 18. npm applies overrides from the install",
    "root, so both must be reproduced wherever the monorepo installs from - see the",
    "overrides inventory in NEXT-PHASE-SCOPE.md 1.19."
  ],
  "overrides": {
    "@stoplight/mosaic": {
      "@types/react": "$@types/react",
      "@types/react-dom": "$@types/react-dom"
    }
  },
