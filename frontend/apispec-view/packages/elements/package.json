{
  "name": "@netcracker/qubership-apihub-apispec-view",
  "version": "2.2.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Netcracker/qubership-apihub.git",
    "directory": "frontend/apispec-view/packages/elements"
  },
  "bugs": {
    "url": "https://github.com/Netcracker/qubership-apihub/issues"
  },
  "homepage": "https://github.com/Netcracker/qubership-apihub/tree/main/frontend/apispec-view/packages/elements#readme",
  "description": "Web Component to represent various API-specifications as a human-readable document",
  "license": "Apache-2.0",
  "sideEffects": [
    "./dist/index.js",
    "src/web-components/**",
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./typings/index.d.ts",
  "exports": {
    "./styles.min.css": "./dist/index.css",
    ".": {
      "types": "./typings/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm run build.webcomponents",
    "postbuild": "pnpm run build.styles",
    "build.styles": "postcss src/styles.css -o dist/index.css",
    "build.webcomponents": "webpack -c ./web-components.config.js",
    "build:showcase": "storybook build -o ../../dist-showcase --disable-telemetry",
    "development:storybook": "storybook dev -p 9099",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "openapi3-ts": "2.0.2"
  },
  "devDependencies": {
    "@netcracker/qubership-apihub-http-spec": "workspace:^",
    "@fortawesome/fontawesome-svg-core": "6.1.1",
    "@stoplight/json": "^3.18.1",
    "@stoplight/mosaic": "^1.40.0",
    "@stoplight/types": "^13.0.0",
    "@stoplight/yaml": "^4.2.3",
    "@types/json-schema": "^7.0.11",
    "@types/swagger-schema-official": "2.0.22",
    "classnames": "^2.2.6",
    "file-saver": "^2.0.5",
    "lodash": "^4.17.21",
    "postcss": "8.5.31",
    "postcss-cli": "8.3.1",
    "react": "^18.3.1",
    "react-query": "^3.34.19",
    "react-router-dom": "^5.2.0",
    "storybook": "^8.2.1",
    "typescript": "catalog:",
    "webpack": "5.76.0",
    "webpack-cli": "4.7.2"
  },
  "nx": {
    "name": "apispec-view"
  }
}
