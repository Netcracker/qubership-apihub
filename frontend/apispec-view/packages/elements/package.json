{
  "name": "@netcracker/qubership-apihub-apispec-view",
  "version": "2.1.4",
  "description": "Web Component to represent various API-specifications as a human-readable document",
  "license": "Apache-2.0",
  "sideEffects": [
    "./dist/index.js",
    "src/web-components/**",
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./typings/index.d.ts",
  "exports": {
    "./styles.min.css": "./dist/index.css",
    ".": {
      "types": "./typings/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate-stories": "node bin/generate-openapi-compatibility-suite-stories.mjs",
    "generate-tests": "node bin/generate-openapi-compatibility-suite-tests.mjs",
    "build": "npm run build.webcomponents",
    "postbuild": "npm run build.styles",
    "build.styles": "postcss src/styles.css -o dist/index.css",
    "build.webcomponents": "webpack -c ./web-components.config.js",
    "build:showcase": "npm run generate-stories && storybook build -o ../../dist-showcase --disable-telemetry",
    "development:storybook": "npm run generate-stories && storybook dev -p 9099",
    "development:local-server:static": "npm run build:showcase && ws -p 9009 -d ../../dist-showcase --spa index.html --static.maxage 3600",
    "screenshot-test": "start-server-and-test development:local-server:static http://localhost:9009 \"npm run generate-tests && jest --maxWorkers 4 -c .config/it/it-test-docker.jest.config.js\"",
    "screenshot-test:ci-legacy": "start-server-and-test development:local-server:static http://localhost:9009 \"npm run generate-tests && jest --maxWorkers 4 -c .config/it/it-test.jest.config.js\"",
    "regenerate-screenshots": "start-server-and-test development:local-server:static http://localhost:9009 \"npm run generate-tests && jest --maxWorkers 4 --updateSnapshot -c .config/it/it-test-docker.jest.config.js\"",
    "regenerate-screenshots:ci-legacy": "start-server-and-test development:local-server:static http://localhost:9009 \"npm run generate-tests && jest --maxWorkers 4 --updateSnapshot -c .config/it/it-test.jest.config.js\"",
    "type-check": "tsc --noEmit"
  },
  "rollup": {
    "bundleDeps": [
      "@fortawesome/free-solid-svg-icons"
    ]
  },
  "dependencies": {
    "openapi3-ts": "2.0.2"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "6.1.1",
    "@jest/globals": "30.4.1",
    "@netcracker/qubership-apihub-apispec-view-samples": "*",
    "@schemastore/package": "0.0.4",
    "@stoplight/json": "^3.18.1",
    "@stoplight/mosaic": "^1.40.0",
    "@stoplight/types": "^13.0.0",
    "@stoplight/yaml": "^4.2.3",
    "@storybook/react": "^8.1.11",
    "@types/json-schema": "^7.0.11",
    "@types/swagger-schema-official": "2.0.22",
    "classnames": "^2.2.6",
    "file-saver": "^2.0.5",
    "fontfaceobserver": "^2.3.0",
    "jest": "30.4.2",
    "jest-image-snapshot": "6.5.2",
    "jest-snapshot": "30.4.1",
    "local-web-server": "5.3.3",
    "lodash": "^4.17.21",
    "postcss": "8.3.5",
    "postcss-cli": "8.3.1",
    "puppeteer": "24.42.0",
    "react": "^18.3.1",
    "react-query": "^3.34.19",
    "react-router-dom": "^5.2.0",
    "start-server-and-test": "2.1.3",
    "storybook": "^8.2.1",
    "typescript": "6.0.3",
    "webpack": "5.76.0",
    "webpack-cli": "4.7.2"
  }
}
