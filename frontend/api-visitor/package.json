{
  "name": "@netcracker/qubership-apihub-api-visitor",
  "version": "1.0.23",
  "description": "Takes OpenAPI documents apart",
  "license": "Apache-2.0",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": "./dist/index.es.js",
    "require": "./dist/index.cjs.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "test": "jest --verbose",
    "lint:check": "eslint -c .eslintrc.json . --ext .js,.cjs,.ts,.json --ignore-path .gitignore --max-warnings 0 --report-unused-disable-directives",
    "lint:fix": "pnpm run lint:check -- --fix"
  },
  "dependencies": {
    "@netcracker/qubership-apihub-api-unifier": "workspace:^",
    "@netcracker/qubership-apihub-json-crawl": "workspace:^"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "6.13.2",
    "@typescript-eslint/parser": "6.13.2",
    "eslint": "8.55.0",
    "eslint-plugin-sort-exports": "0.8.0",
    "jest": "30.4.2",
    "jest-extended": "^4.0.2",
    "jest-util": "^30.4.1",
    "openapi-types": "12.1.3",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  },
  "eslintConfig": {
    "extends": ".eslintrc.json"
  },
  "nx": {
    "name": "api-visitor"
  }
}
