{
  "name": "@netcracker/qubership-apihub-class-view",
  "version": "1.0.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Netcracker/qubership-apihub.git",
    "directory": "frontend/class-view"
  },
  "bugs": {
    "url": "https://github.com/Netcracker/qubership-apihub/issues"
  },
  "homepage": "https://github.com/Netcracker/qubership-apihub/tree/main/frontend/class-view#readme",
  "license": "Apache-2.0",
  "type": "module",
  "module": "./dist/index.es.js",
  "main": "dist/index.cjs.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./class-view.css": "./dist/style.css"
  },
  "sideEffects": false,
  "scripts": {
    "lint:check": "tsc && eslint src --ext ts --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "pnpm run lint:check -- --fix",
    "build": "pnpm run build:dist && pnpm run build:showcase",
    "build:dist": "vite build",
    "build:showcase": "storybook build -o dist-showcase",
    "screenshot-test": "start-server-and-test screenshot-test:server http://localhost:6006 screenshot-test:run-local",
    "screenshot-test:ci-legacy": "start-server-and-test screenshot-test:server http://localhost:6006 screenshot-test:run-ci",
    "regenerate-screenshots": "start-server-and-test screenshot-test:server http://localhost:6006 \"jest --maxWorkers 4 --updateSnapshot -c .jest/integration/it-test-docker.jest.config.cjs\"",
    "regenerate-screenshots:ci-legacy": "start-server-and-test screenshot-test:server http://localhost:6006 \"jest --maxWorkers 8 --updateSnapshot -c .jest/integration/it-test.jest.config.cjs\"",
    "screenshot-test:server": "pnpm run build:showcase && ws -p 6006 -d dist-showcase --spa index.html --static.maxage 3600",
    "screenshot-test:run-local": "jest --maxWorkers 4 -c .jest/integration/it-test-docker.jest.config.cjs",
    "screenshot-test:run-ci": "jest --maxWorkers 8 -c .jest/integration/it-test.jest.config.cjs",
    "development:local-server": "storybook dev -p 6006",
    "feature-start": "feature-start --featureName",
    "feature-finish": "feature-finish"
  },
  "dependencies": {
    "d3": "^7.8.5",
    "elkjs": "^0.8.2",
    "fast-equals": "^6.0.2",
    "fontfaceobserver": "^2.3.0",
    "lodash-es": "^4.17.21",
    "web-worker": "^1.0.0",
    "svg-round-corners": "0.4.1"
  },
  "devDependencies": {
    "@netcracker/qubership-apihub-jest-chrome-in-docker-environment": "workspace:^",
    "@storybook/addon-links": "catalog:",
    "@storybook/html-vite": "catalog:",
    "@types/d3": "^7.4.3",
    "@types/fontfaceobserver": "^2.1.2",
    "@types/jest": "catalog:",
    "@types/jest-image-snapshot": "6.1.0",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "eslint-plugin-storybook": "catalog:",
    "jest": "catalog:",
    "jest-environment-puppeteer": "11.0.0",
    "jest-image-snapshot": "6.5.2",
    "jest-puppeteer": "11.0.0",
    "jest-util": "catalog:",
    "local-web-server": "5.3.0",
    "puppeteer": "24.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "start-server-and-test": "2.0.0",
    "storybook": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "overrides": {
    "jest-environment-node": "30.4.1",
    "jest-mock": "30.4.1"
  },
  "nx": {
    "name": "class-view"
  }
}
