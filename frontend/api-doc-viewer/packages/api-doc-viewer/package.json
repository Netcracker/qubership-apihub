{
  "name": "@netcracker/qubership-apihub-api-doc-viewer",
  "version": "3.4.2",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/style.css": {
      "import": "./dist/style.css",
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "test": "jest --maxWorkers 3 --verbose",
    "build": "npm run build:dist",
    "build:dist": "tsc && vite build",
    "build:showcase": "npm run generate-stories && storybook build -o ../../dist-showcase --disable-telemetry",
    "generate-stories": "node bin/generate-compatibility-suite-stories.mjs && node bin/generate-ddl-suite-stories.mjs",
    "generate-tests": "node bin/generate-compatibility-suite-tests.mjs && node bin/generate-ddl-suite-tests.mjs",
    "development:storybook": "npm run generate-stories && storybook dev -p 9099",
    "development:local-server:static": "npm run build:showcase && ws -p 9009 -d ../../dist-showcase --spa index.html --static.maxage 3600",
    "screenshot-test": "start-server-and-test development:local-server:static http://localhost:9009 \"npm run generate-tests && jest --maxWorkers 4 -c .config/it/it-test-docker.jest.config.cjs\"",
    "screenshot-test:ci-legacy": "start-server-and-test development:local-server:static http://localhost:9009 \"npm run generate-tests && jest --maxWorkers 4 -c .config/it/it-test.jest.config.cjs\"",
    "regenerate-screenshots": "start-server-and-test development:local-server:static http://localhost:9009 \"npm run generate-tests && jest --maxWorkers 4 --updateSnapshot -c .config/it/it-test-docker.jest.config.cjs\"",
    "regenerate-screenshots:ci-legacy": "start-server-and-test development:local-server:static http://localhost:9009 \"npm run generate-tests && jest --maxWorkers 4 --updateSnapshot -c .config/it/it-test.jest.config.cjs\"",
    "screenshot-test-single-suite": "node bin/run-screenshot-test-suite.mjs test",
    "regenerate-screenshots-single-suite": "node bin/run-screenshot-test-suite.mjs regenerate"
  },
  "dependencies": {
    "lodash-es": "^4.17.21",
    "postcss": "8.4.29",
    "react-markdown": "8.0.7",
    "react-use": "^17.6.0",
    "remark-gfm": "3.0.1",
    "tailwindcss": "3.3.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.4.0",
    "@clack/prompts": "^0.9.1",
    "@jest/globals": "30.4.1",
    "@monaco-editor/react": "^4.7.0",
    "@netcracker/qubership-apihub-api-data-model": "*",
    "@netcracker/qubership-apihub-api-state-model": "*",
    "@netcracker/qubership-apihub-next-data-model": "*",
    "@netcracker/qubership-apihub-samples": "*",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-links": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@types/fontfaceobserver": "2.1.0",
    "@types/jest": "30.0.0",
    "@types/jest-image-snapshot": "6.1.0",
    "@types/json-schema": "^7.0.12",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "10.4.15",
    "fontfaceobserver": "^2.3.0",
    "graphql": "16.12.0",
    "jest": "30.4.2",
    "jest-environment-puppeteer": "11.0.0",
    "jest-image-snapshot": "6.5.2",
    "jest-image-snapshot-diff-reporter": "1.0.0",
    "jest-puppeteer": "11.0.0",
    "jest-snapshot": "30.4.1",
    "local-web-server": "5.3.0",
    "puppeteer": "24.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-remove-scroll": "^2.6.0",
    "rolldown": "~1.2.4",
    "start-server-and-test": "2.1.3",
    "storybook": "10.5.10",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  }
}
