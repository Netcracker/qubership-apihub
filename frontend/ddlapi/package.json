{
  "name": "@netcracker/qubership-apihub-ddlapi",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Netcracker/qubership-apihub.git",
    "directory": "frontend/ddlapi"
  },
  "bugs": {
    "url": "https://github.com/Netcracker/qubership-apihub/issues"
  },
  "homepage": "https://github.com/Netcracker/qubership-apihub/tree/main/frontend/ddlapi#readme",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "browser": "./dist/parser.browser.js",
      "import": "./dist/parser.browser.js",
      "require": "./dist/parser.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "parser": [
        "./dist/parser.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "vite build && vite build --config vite.browser.config.ts",
    "postbuild": "node scripts/assert-model-entry-parser-free.mjs",
    "assert:model-entry": "node scripts/assert-model-entry-parser-free.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "jest-util": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "dependencies": {
    "@pgsql/types": "17.6.2",
    "libpg-query": "17.7.3",
    "pgsql-deparser": "17.18.3"
  },
  "nx": {
    "name": "ddlapi"
  }
}
