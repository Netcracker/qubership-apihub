{
    "info": {
        "name": "5_Migration",
        "_postman_id": "e119a392-5847-4c42-8c72-d4f9af11a057",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "Independent operations migration regression suite. Requires SERVER_HOST and local administrator Username/Password. Logs in itself, creates a unique workspace, publishes its own OpenAPI fixture, verifies exact scoped rebuilds, and deletes its workspace. No other collection or shared test fixture is required. Run on an isolated test instance: migrations use an exclusive global slot. On timeout, the suite cancels its own running migration and waits for it to stop before cleanup."
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{migrationScopeToken}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "0. Login as administrator",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "Object.keys(pm.environment.toObject()).filter(function (key) {",
                            "  return key.startsWith('migrationScope');",
                            "}).forEach(function (key) { pm.environment.unset(key); });"
                        ]
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "let token;",
                            "pm.test('Administrator login succeeds', function () {",
                            "  pm.response.to.have.status(200);",
                            "  token = pm.response.json().token;",
                            "  pm.expect(token).to.be.a('string').and.not.empty;",
                            "});",
                            "if (typeof token === 'string' && token.length > 0) {",
                            "  pm.environment.set('migrationScopeToken', token);",
                            "} else { pm.execution.setNextRequest(null); }"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "auth": {
                    "type": "basic",
                    "basic": [
                        {
                            "key": "username",
                            "value": "{{Username}}",
                            "type": "string"
                        },
                        {
                            "key": "password",
                            "value": "{{Password}}",
                            "type": "string"
                        }
                    ]
                },
                "url": "{{SERVER_HOST}}/api/v2/auth/local"
            }
        },
        {
            "name": "1. Partial migration by workspace or group scopes",
            "description": "Checks invalid scopes and unpublished packages, then publishes two independent versions in each of four isolated packages. Successful migrations cover an exact package ID, a group, mixed overlapping scopes, and a workspace. Reports must contain the exact successful build count; persisted builds must match the requested package IDs and versions for that migration ID. CI runs this scenario sequentially because migrations are exclusive.",
            "item": [
                {
                    "name": "1057 - Create isolated hierarchy",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.environment.set('migrationScopeAlias', 'mg' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8));"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Migration scope workspace created', function () { pm.response.to.have.status(201); });",
                                    "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); } else {",
                                    "  const workspaceId = pm.response.json().packageId;",
                                    "  pm.environment.set('migrationScopeWorkspace', workspaceId);",
                                    "  const packages = ['.group.direct', '.group.nested.leaf', '.groupother.sibling', '.root'].map(function (suffix) { return workspaceId + suffix; });",
                                    "  pm.environment.set('migrationScopePackages', JSON.stringify(packages));",
                                    "  pm.environment.set('migrationScopePublications', JSON.stringify(packages.flatMap(function (packageId) {",
                                    "    return ['1.0', '2.0'].map(function (version) { return { packageId, version }; });",
                                    "  })));",
                                    "  pm.environment.set('migrationScopePublicationIndex', '0');",
                                    "  const cases = [",
                                    "    { name: 'exact package ID', packageIds: [packages[1]], versions: ['1.0'], expected: [{ packageId: packages[1], versions: ['1.0@1'] }] },",
                                    "    { name: 'group scope', packageIds: [workspaceId + '.group.*'], versions: ['1.0'], expected: packages.slice(0, 2).map(function (packageId) { return { packageId, versions: ['1.0@1'] }; }) },",
                                    "    { name: 'mixed overlapping scopes', packageIds: [workspaceId + '.group.*', workspaceId + '.group.nested.*', packages[1], packages[2], workspaceId + '.dashboards.*'], versions: ['2.0'], expected: packages.slice(0, 3).map(function (packageId) { return { packageId, versions: ['2.0@1'] }; }) },",
                                    "    { name: 'workspace scope', packageIds: [workspaceId + '.*'], expected: packages.map(function (packageId) { return { packageId, versions: ['1.0@1', '2.0@1'] }; }) }",
                                    "  ];",
                                    "  pm.environment.set('migrationScopeCases', JSON.stringify(cases));",
                                    "  pm.environment.set('migrationScopeCaseIndex', '0');",
                                    "  const entities = [",
                                    "    ['group', '', 'group'],",
                                    "    ['direct', '.group', 'package'],",
                                    "    ['nested', '.group', 'group'],",
                                    "    ['leaf', '.group.nested', 'package'],",
                                    "    ['groupother', '', 'group'],",
                                    "    ['sibling', '.groupother', 'package'],",
                                    "    ['dashboards', '', 'group'],",
                                    "    ['dash', '.dashboards', 'dashboard'],",
                                    "    ['root', '', 'package'],",
                                    "    ['empty', '', 'group']",
                                    "  ];",
                                    "  function createNext(index) {",
                                    "    if (index === entities.length) { return; }",
                                    "    const [alias, parentSuffix, kind] = entities[index];",
                                    "    pm.sendRequest({",
                                    "      url: pm.environment.get('SERVER_HOST') + '/api/v2/packages',",
                                    "      method: 'POST',",
                                    "      header: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.environment.get('migrationScopeToken') },",
                                    "      body: { mode: 'raw', raw: JSON.stringify({ alias, parentId: workspaceId + parentSuffix, kind, name: alias }) }",
                                    "    }, function (err, response) {",
                                    "      pm.test('Create migration scope ' + alias, function () {",
                                    "        pm.expect(err).to.equal(null);",
                                    "        pm.expect(response.code).to.equal(201);",
                                    "      });",
                                    "      if (err || response.code !== 201) {",
                                    "        pm.execution.setNextRequest('1057 - Delete isolated workspace');",
                                    "        return;",
                                    "      }",
                                    "      createNext(index + 1);",
                                    "    });",
                                    "  }",
                                    "  createNext(0);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"alias\":\"{{migrationScopeAlias}}\",\"kind\":\"workspace\",\"name\":\"Migration workspace and group scope test\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": "{{SERVER_HOST}}/api/v2/packages"
                    }
                },
                {
                    "name": "1057 - Reject invalid scopes",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Scope is rejected without starting a migration', function () {",
                                    "  pm.response.to.have.status(400);",
                                    "  pm.expect(pm.response.json().code).to.equal('9');",
                                    "});"
                                ]
                            }
                        }
                    ],
