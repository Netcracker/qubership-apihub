{
  "name": "@netcracker/qubership-apihub-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "nx": {
    "name": "landing",
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ],
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/docs/images/architecture/*.svg"
        ]
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Netcracker/qubership-apihub.git",
    "directory": "sites/landing"
  },
  "scripts": {
    "copy-diagrams": "node scripts/copy-diagrams.mjs",
    "dev": "node scripts/copy-diagrams.mjs && astro dev --host",
    "build": "node scripts/copy-diagrams.mjs && astro build",
    "preview": "astro preview --host"
  },
  "dependencies": {
    "astro": "7.4.2",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19"
  }
}
