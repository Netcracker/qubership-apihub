---
import Layout from '../../layouts/Layout.astro';
import { docsNav, externalGuides } from '../../data/docs';
import { subCapabilityCount } from '../../data/architecture';
import { withBase } from '../../lib/paths';

const home = import.meta.env.BASE_URL;
const architecture = docsNav.find((s) => s.label === 'Architecture')!;
---

<Layout
  title="Documentation — Qubership APIHUB"
  description="Documentation hub for Qubership APIHUB: the platform architecture in C4 notation, runtime flows, the capability map, and links to the installation, user and administrator guides."
>
  <!-- ══ HERO ═══════════════════════════════════════════════════════════════ -->
  <section class="relative pt-16 pb-12 px-6 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[400px] rounded-full opacity-15"
        style="background: radial-gradient(ellipse at center, rgba(96,165,250,0.6) 0%, transparent 70%); filter: blur(50px);"
      ></div>
    </div>
    <div class="relative max-w-3xl mx-auto text-center">
      <nav class="flex items-center justify-center gap-2 mb-6 text-sm text-slate-500">
        <a href={home} class="hover:text-white transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
        <span class="text-slate-300">Docs</span>
      </nav>
      <p class="text-sm font-semibold text-blue-400 uppercase tracking-widest mb-3">Documentation</p>
      <h1 class="text-4xl md:text-5xl font-black text-white mb-5 tracking-tight">
        How APIHUB is<br />
        <span class="gradient-text">built and how it runs</span>
      </h1>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        The architecture documentation lives here, on this site. Operational and end-user guides are
        versioned with the product and live in the repository.
      </p>
    </div>
  </section>

  <!-- ══ ARCHITECTURE ═══════════════════════════════════════════════════════ -->
  <section class="pb-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-baseline justify-between gap-4 mb-6 flex-wrap">
        <div>
          <h2 class="text-2xl font-bold text-white mb-1.5">Architecture</h2>
          <p class="text-sm text-slate-500">
            The C4 model from context down to code, three runtime flows, and {subCapabilityCount} sub-capabilities mapped
            onto the services that implement them.
          </p>
        </div>
        <a
          href={withBase('docs/architecture/')}
          class="btn-primary flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-white flex-shrink-0"
        >
          Start reading
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        {architecture.pages.map((page, i) => (
          <a
            href={page.href}
            class="group rounded-2xl border border-slate-800 bg-slate-900/30 p-6 card-glow transition-colors hover:border-blue-500/40"
          >
            <div class="flex items-start gap-4">
              <span class="font-mono text-xs text-slate-700 pt-1 tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <div class="min-w-0">
                <h3 class="text-base font-bold text-white mb-2 group-hover:text-blue-400 transition-colors">
                  {page.label}
                </h3>
                <p class="text-sm text-slate-500 leading-relaxed">{page.summary}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ GUIDES IN THE REPOSITORY ═══════════════════════════════════════════ -->
  <section class="pb-16 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-bold text-white mb-1.5">Guides</h2>
      <p class="text-sm text-slate-500 mb-6">
        Installation, day-to-day usage and administration are versioned with the product, so they stay in
        the <code class="font-mono text-xs text-slate-400">qubership-apihub</code> repository.
      </p>

      <div class="grid sm:grid-cols-2 gap-4">
        {externalGuides.map((guide) => (
          <a
            href={guide.href}
            target="_blank"
            rel="noopener"
            class="group rounded-xl border border-slate-800 p-5 hover:border-slate-700 transition-colors"
          >
            <div class="flex items-center gap-2 mb-2">
              <h3 class="text-sm font-bold text-slate-200 group-hover:text-white transition-colors">{guide.label}</h3>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-slate-600 group-hover:text-slate-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">{guide.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ WHAT COMES NEXT ════════════════════════════════════════════════════ -->
  <section class="pb-20 px-6">
    <div class="max-w-6xl mx-auto rounded-2xl border border-slate-800 border-dashed p-7">
      <div class="flex items-start gap-4">
        <span class="mt-0.5 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-widest bg-slate-800 text-slate-400 flex-shrink-0">
          Planned
        </span>
        <div>
          <h2 class="text-base font-bold text-white mb-2">User documentation on this site</h2>
          <p class="text-sm text-slate-500 leading-relaxed max-w-3xl">
            This section is built to grow. End-user documentation — publishing walkthroughs, comparison and
            governance workflows, CI recipes — is intended to move here from the repository guides, so that
            readers get search, cross-linking and the same navigation as the architecture pages.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ PAGE NAV ═══════════════════════════════════════════════════════════ -->
  <nav class="py-10 px-6 border-t border-slate-800/40">
    <div class="max-w-5xl mx-auto flex items-center justify-between">
      <a href={withBase('deploy/')} class="flex items-center gap-2 text-sm text-slate-500 hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
        Deploy
      </a>
      <a href={withBase('docs/architecture/')} class="flex items-center gap-2 text-sm text-blue-400 hover:text-blue-300 transition-colors font-medium">
        Architecture overview
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
      </a>
    </div>
  </nav>
</Layout>
