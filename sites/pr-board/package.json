{
  "name": "@netcracker/qubership-apihub-pr-board",
  "private": true,
  "description": "Open pull request board for one or more GitHub repositories, published on GitHub Pages",
  "type": "module",
  "nx": {
    "name": "pr-board",
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          { "env": "PR_BOARD_REPO" },
          { "env": "PR_BOARD_GROUPS" },
          { "env": "PR_BOARD_BOTS" }
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm run typecheck && pnpm run test:coverage && pnpm run test:requirements",
          "cwd": "sites/pr-board"
        }
      },
      "test:e2e": {
        "cache": true
      },
      "test:linux": {
        "cache": false
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Netcracker/qubership-apihub.git",
    "directory": "sites/pr-board"
  },
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode live",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test --project=e2e",
    "test:linux": "node scripts/linux-checks.ts",
    "test:screenshots": "playwright test --project=screenshots",
    "test:screenshots:update": "playwright test --project=screenshots --update-snapshots",
    "test:requirements": "node scripts/check-requirements.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=90"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
