            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var attempts = parseInt(pm.collectionVariables.get('pollAttempts') || '0', 10);",
                  "if (attempts > 0) { var until = Date.now() + parseInt(pm.collectionVariables.get('pollDelayMs') || '1000', 10); while (Date.now() < until) {} }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard v2 status endpoint succeeds', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "if (json.status === 'complete') { pm.collectionVariables.set('pollAttempts', '0'); }",
                  "else if (json.status === 'error') { pm.test('Dashboard v2 build succeeds', function () { pm.expect.fail(json.message || 'build failed'); }); }",
                  "else {",
                  "    var attempts = parseInt(pm.collectionVariables.get('pollAttempts') || '0', 10) + 1;",
                  "    pm.collectionVariables.set('pollAttempts', String(attempts));",
                  "    if (attempts < parseInt(pm.collectionVariables.get('maxPollAttempts'), 10)) { pm.execution.setNextRequest(pm.info.requestName); }",
                  "    else { pm.test('Dashboard v2 completes before timeout', function () { pm.expect.fail('publish timeout'); }); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v2/packages/{{dashboardPackageId}}/publish/{{publishId}}/status"
          },
          "response": []
