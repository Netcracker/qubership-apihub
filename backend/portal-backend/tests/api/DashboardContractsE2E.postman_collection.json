{
  "info": {
    "_postman_id": "7a273390-34ea-4a2f-8f18-811a19c516bb",
    "name": "Dashboard DDL and MCP contracts E2E",
    "description": "Creates an isolated workspace, two referenced packages, and a dashboard; publishes v1 and v2 of every package; verifies dashboard DDL and MCP aggregation, scoping, exports, and DDL changelog behaviour; then removes all created packages.\n\nPrerequisites: the backend and build-task-consumer must be running, and apiKey must permit package creation and publication.\n\nRun from the repository root so multipart fixtures resolve:\nnewman run tests/api/DashboardContractsE2E.postman_collection.json --working-dir .\n\nA unique suffix is generated once per run. All package aliases remain within the API's 10-character limit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runSuffix')) {",
          "    var suffix = (Date.now().toString(36) + Math.random().toString(36).slice(2)).slice(-7);",
          "    pm.collectionVariables.set('runSuffix', suffix);",
          "    pm.collectionVariables.set('workspaceAlias', 'dcw' + suffix);",
          "    pm.collectionVariables.set('alphaAlias', 'dca' + suffix);",
          "    pm.collectionVariables.set('betaAlias', 'dcb' + suffix);",
          "    pm.collectionVariables.set('dashboardAlias', 'dcd' + suffix);",
          "}"
        ]
      }
    }
  ],
