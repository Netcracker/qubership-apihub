          "name": "Create workspace",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Workspace created', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.packageId).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('workspaceId', json.packageId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alias\": \"{{workspaceAlias}}\",\n  \"kind\": \"workspace\",\n  \"name\": \"Dashboard contracts E2E {{runSuffix}}\"\n}",
              "options": {
