                  "pm.test('Alpha v1 publish accepted', function () { pm.response.to.have.status(202); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('publishId', json.publishId);",
                  "pm.collectionVariables.set('pollAttempts', '0');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "config",
                  "value": "{\"packageId\":\"{{alphaPackageId}}\",\"version\":\"{{version1}}\",\"status\":\"{{versionStatus}}\",\"files\":[{\"fileId\":\"schema.sql\",\"publish\":true},{\"fileId\":\"init.json\",\"publish\":true,\"metadata\":{\"mcpEndpoint\":\"/mcp\"}},{\"fileId\":\"tools.json\",\"publish\":true,\"metadata\":{\"mcpEndpoint\":\"/mcp\"}}]}",
                  "type": "text"
                },
                {
                  "key": "sources",
                  "type": "file",
                  "src": "tests/api/fixtures/dashboard-contracts/alpha-v1.zip"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v2/packages/{{alphaPackageId}}/publish"
          },
          "response": []
        },
        {
          "name": "Wait for alpha v1",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var attempts = parseInt(pm.collectionVariables.get('pollAttempts') || '0', 10);",
                  "if (attempts > 0) {",
                  "    var until = Date.now() + parseInt(pm.collectionVariables.get('pollDelayMs') || '1000', 10);",
                  "    while (Date.now() < until) {}",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Alpha v1 status endpoint succeeds', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "if (json.status === 'complete') {",
                  "    pm.collectionVariables.set('pollAttempts', '0');",
                  "} else if (json.status === 'error') {",
                  "    pm.test('Alpha v1 build succeeds', function () { pm.expect.fail(json.message || 'build failed'); });",
                  "} else {",
                  "    var attempts = parseInt(pm.collectionVariables.get('pollAttempts') || '0', 10) + 1;",
                  "    pm.collectionVariables.set('pollAttempts', String(attempts));",
                  "    if (attempts < parseInt(pm.collectionVariables.get('maxPollAttempts'), 10)) { pm.execution.setNextRequest(pm.info.requestName); }",
                  "    else { pm.test('Alpha v1 completes before timeout', function () { pm.expect.fail('publish timeout'); }); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v2/packages/{{alphaPackageId}}/publish/{{publishId}}/status"
