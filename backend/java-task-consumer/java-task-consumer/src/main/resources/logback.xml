<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>[%d{yyyy-MM-dd'T'HH:mm:ss.SSS,UTC}] [%level] [request_id=%X{requestId}] [tenant_id=] [thread_id=%thread] [class=%logger] %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
