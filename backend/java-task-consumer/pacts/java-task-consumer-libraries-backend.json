{
  "consumer": {
    "name": "java-task-consumer"
  },
  "interactions": [
    {
      "description": "a poll that takes a java-api-report task",
      "providerStates": [
        {
          "name": "a java-api-report task is queued for builder builder-test-1"
        }
      ],
      "request": {
        "headers": {
          "api-key": "test-api-key"
        },
        "method": "POST",
        "path": "/api/v2/java-builders/builder-test-1/tasks"
      },
      "response": {
        "body": "",
        "headers": {
          "Content-Type": "application/zip"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "contentType",
                  "value": "application/zip"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a complete status with a result ZIP",
      "providerStates": [
        {
          "name": "java publish pub-99 exists for library demo-lib"
        }
      ],
      "request": {
        "body": "",
        "headers": {
          "Content-Type": "multipart/form-data; boundary=----JavaTaskConsumerPactExample",
          "api-key": "test-api-key"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "multipart/form-data;\\s*boundary=.+"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/v3/libraries/demo-lib/java-publish/pub-99/status"
      },
      "response": {
        "status": 204
      }
    },
    {
      "description": "a running heartbeat for a java publish",
      "providerStates": [
        {
          "name": "java publish pub-99 exists for library demo-lib"
        }
      ],
      "request": {
        "body": "",
        "headers": {
          "Content-Type": "multipart/form-data; boundary=----JavaTaskConsumerPactExample",
          "api-key": "test-api-key"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "multipart/form-data;\\s*boundary=.+"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/v3/libraries/demo-lib/java-publish/pub-99/status"
      },
      "response": {
        "status": 204
      }
    },
    {
      "description": "an error status with a human-readable message",
      "providerStates": [
        {
          "name": "java publish pub-99 exists for library demo-lib"
        }
      ],
      "request": {
        "body": "",
        "headers": {
          "Content-Type": "multipart/form-data; boundary=----JavaTaskConsumerPactExample",
          "api-key": "test-api-key"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "multipart/form-data;\\s*boundary=.+"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/v3/libraries/demo-lib/java-publish/pub-99/status"
      },
      "response": {
        "status": 204
      }
    },
    {
      "description": "a poll when the java build queue is empty",
      "providerStates": [
        {
          "name": "no java build tasks are available"
        }
      ],
      "request": {
        "headers": {
          "api-key": "test-api-key"
        },
        "method": "POST",
        "path": "/api/v2/java-builders/builder-test-1/tasks"
      },
      "response": {
        "status": 204
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.6"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "libraries-backend"
  }
}
